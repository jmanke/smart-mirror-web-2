<label>
  City
</label>
<input
  class="border border-gray-500 pl-1"
  value={{@location.city}}
  placeholder="Redlands"
  required
  {{on 'change' this.updateCity }}
/>

<label>
  State
</label>
<input
  class="border border-gray-500 pl-1"
  value={{@location.state}}
  placeholder="CA"
  required
  {{on 'change' this.updateState}}
/>

<label>
  Country code
</label>
<input
  class="border border-gray-500 pl-1"
  value={{@location.country}}
  placeholder="USA"
  required
  {{on 'change' this.updateCountry}}
/>